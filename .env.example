# ==============================================================================
# SOCOFEB DÉCOR — Configuration des variables d'environnement
# ==============================================================================
# IMPORTANT:
# - Ne jamais commiter de clés réelles ou de secrets dans le dépôt git.
# - En local : dupliquez ce fichier vers '.env.local' (qui est ignoré par git).
# - En production Vercel : configurez ces variables dans :
#   Project Settings -> Environment Variables (Production & Preview).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Fournisseur d'email principal : Resend (Recommandé pour Vercel)
# ------------------------------------------------------------------------------
# Obtenez votre clé d'API sur https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Adresse d'expédition autorisée sur votre domaine vérifié Resend
# Par défaut pour les tests Resend : 'SOCOFEB Devis <onboarding@resend.dev>'
# En production sur domaine vérifié : 'SOCOFEB Devis <devis@socofeb-decor.com>'
CONTACT_FROM_EMAIL=SOCOFEB Devis <onboarding@resend.dev>

# Adresse de réception des demandes de devis (direction commerciale SOCOFEB)
CONTACT_TO_EMAIL=contact@socofeb.tn

# ------------------------------------------------------------------------------
# 2. Webhook secondaire / CRM (Optionnel)
# ------------------------------------------------------------------------------
# URL d'un webhook (ex: Slack Incoming Webhook, Discord, Make, Zapier, n8n ou CRM)
# Si défini, chaque devis y sera également envoyé au format JSON.
# CONTACT_WEBHOOK_URL=https://hooks.slack.com/services/...

# ------------------------------------------------------------------------------
# 3. Mode développement local (Uniquement pour NODE_ENV=development)
# ------------------------------------------------------------------------------
# Si défini à 'true' en local, les devis sont affichés dans la console du terminal
# et la soumission est acceptée pour tester l'UI sans compte Resend actif.
# Cette variable est strictement ignorée en environnement de production (NODE_ENV=production).
CONTACT_DEV_MODE=false
